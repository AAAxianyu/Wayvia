[Unit]
Description=Wayvia per-device proxy usage observations
After=wayvia-agent.service
Requires=wayvia-agent.service

[Service]
Type=simple
User=wayvia
Group=wayvia
ExecStart=/opt/wayvia/.venv/bin/wayvia --system usage-collect
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wayvia/control
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
