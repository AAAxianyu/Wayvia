[Unit]
Description=Wayvia bounded passive log collector and private query broker
ConditionPathExists=/var/lib/wayvia-observer/collector.json

[Service]
Type=simple
User=wayvia-observer
Group=wayvia-observer
Slice=wayvia-observation.slice
StateDirectory=wayvia-observer
StateDirectoryMode=0700
RuntimeDirectory=wayvia-log
RuntimeDirectoryMode=0755
ExecStart=/opt/wayvia/.venv/bin/wayvia logs collect /var/lib/wayvia-observer /var/lib/wayvia-observer/collector.json
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/wayvia-observer /run/wayvia-log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
