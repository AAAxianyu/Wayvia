FROM wayvia-lab-systemd:locked
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends netcat-openbsd && rm -rf /var/lib/apt/lists/*
RUN /opt/wayvia-lab-python/bin/pip install uv==0.9.7
ENV PATH="/opt/wayvia-lab-python/bin:${PATH}" UV_CACHE_DIR=/opt/wayvia-uv-cache UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock /workspace/
RUN UV_PROJECT_ENVIRONMENT=/opt/wayvia-cache-warm uv sync --locked --no-dev --no-install-project --project /workspace --python python3.12
COPY src/ /workspace/src/
COPY deploy/ /workspace/deploy/
COPY tests/lab/ /workspace/tests/lab/
COPY dist/ /workspace/dist/
COPY components/ /components/
RUN rm -f /usr/local/bin/sing-box /usr/local/bin/mihomo /usr/local/bin/v2raya /usr/local/bin/v2raya_core /usr/local/bin/v2ray /usr/local/share/v2raya/geoip.dat /usr/local/share/v2raya/geosite.dat
ENV UV_OFFLINE=true PYTHONPATH=""
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
